# Configuracion del Bot de Pronosticos
# Copia este archivo como ".env" y rellena los valores

# --- BOT DE TELEGRAM ---
TELEGRAM_TOKEN=tu_token_de_botfather

# --- APIs EXTERNAS ---
BZZOIRO_API_KEY=tu_api_key_de_bzzoiro

# --- BASE DE DATOS ---
# Por defecto usa SQLite local. Para PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///bot.db

# --- CONFIGURACION ---
LOG_LEVEL=INFO
DEBUG=false
